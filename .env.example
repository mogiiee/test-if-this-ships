PORT=8787

# Anthropic — production uses AWS WIF (no API key). Local can still use a key.
ANTHROPIC_API_KEY=
ANTHROPIC_FEDERATION_RULE_ID=
ANTHROPIC_ORGANIZATION_ID=
ANTHROPIC_SERVICE_ACCOUNT_ID=
ANTHROPIC_WORKSPACE_ID=

# Models — triage always runs first; then deep (Opus 5) or Sonnet 5 or triage-only
MODEL_TRIAGE=claude-haiku-4-5
MODEL_SONNET=claude-sonnet-5
MODEL_OPUS=claude-opus-5

# GitHub — all credentials come from env (no secrets in code)
# PAT: read core repo + post PR comments / manual /review
GITHUB_TOKEN=

# GitHub App (webhooks on installed repos)
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

# Core source on GitHub (fetched by version from the PR package.json)
CORE_REPO=QdRepo/appt_bridge_core

# Bot mention handle (without @)
BOT_LOGIN=if-this-ships

# Live teach notes (separate repo — never written to this repo's main)
LEARNED_REPO=QdRepo/if-this-ships-notes
LEARNED_PATH=learned.md
LEARNED_REF=main
